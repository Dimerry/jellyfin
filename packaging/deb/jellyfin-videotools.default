# Defaults for the jellyfin-videotools service.
# This file is a dpkg conffile: your changes survive upgrades, package updates
# will be installed as jellyfin-videotools.dpkg-dist when you edited it.

# Where the database, metadata and (by default) the config live.
JELLYFIN_DATA_DIR=/var/lib/jellyfin-videotools

# Config directory. Moves user settings and images out of the data dir.
JELLYFIN_CONFIG_DIR=/etc/jellyfin-videotools

# Transcoding scratch space.
JELLYFIN_CACHE_DIR=/var/cache/jellyfin-videotools

# Log files (jellyfin.log lives here once --logdir is set).
JELLYFIN_LOG_DIR=/var/log/jellyfin-videotools

# Bundled web client (built from Dimerry/jellyfin-web, branch videotools-12.4).
JELLYFIN_WEB_DIR=/opt/jellyfin-videotools/jellyfin-web

# Extra command line switches, e.g. a different port is set in config/network.xml
# rather than here. Example:
# JELLYFIN_ADDITIONAL_OPTS="--published-server-url http://jellyfin.example.com"
JELLYFIN_ADDITIONAL_OPTS=
